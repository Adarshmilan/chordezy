<?xml version="1.0" encoding="utf-8"?>
<!--
  Chordsezy logo: a three-note chord (root, 3rd, 5th) stacked on a music staff.
  Orange = root, gold = 3rd, blue = 5th. Kept inside the adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Staff lines -->
    <path
        android:pathData="M28,40H80 M28,48H80 M28,56H80 M28,64H80 M28,72H80"
        android:strokeWidth="1.6"
        android:strokeColor="#55FFFFFF"
        android:strokeLineCap="round" />

    <!-- Stem -->
    <path
        android:pathData="M56.4,70.5V30"
        android:strokeWidth="2.6"
        android:strokeColor="#FFF2F2F7"
        android:strokeLineCap="round" />

    <!-- Root -->
    <group android:pivotX="50" android:pivotY="72" android:rotation="-20">
        <path
            android:fillColor="#FFFF9F43"
            android:pathData="M43,72a7,5 0,1 0,14 0a7,5 0,1 0,-14 0z" />
    </group>

    <!-- 3rd -->
    <group android:pivotX="50" android:pivotY="64" android:rotation="-20">
        <path
            android:fillColor="#FFFFB547"
            android:pathData="M43,64a7,5 0,1 0,14 0a7,5 0,1 0,-14 0z" />
    </group>

    <!-- 5th -->
    <group android:pivotX="50" android:pivotY="56" android:rotation="-20">
        <path
            android:fillColor="#FF54A0FF"
            android:pathData="M43,56a7,5 0,1 0,14 0a7,5 0,1 0,-14 0z" />
    </group>
</vector>
